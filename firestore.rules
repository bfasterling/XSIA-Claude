rules_version = '2';
// Todo el acceso a datos pasa por la API (Cloud Run con cuenta de servicio, que ignora estas reglas).
// Los clientes web no leen ni escriben Firestore directamente.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
