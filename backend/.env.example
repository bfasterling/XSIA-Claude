# ---- Desarrollo local (ROLE=all ejecuta API + worker en un solo proceso) ----
ROLE=all
PORT=8080
GOOGLE_CLOUD_PROJECT=tu-proyecto
GCP_REGION=us-central1
# Credenciales locales: gcloud auth application-default login
PUBLIC_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:8080
CORS_ORIGINS=*
ADMIN_EMAILS=tu-correo@empresa.com
DEFAULT_TIMEZONE=America/Mexico_City

GCS_BUCKET=tu-proyecto-xsia-data
GCS_MEDIA_BUCKET=tu-proyecto-xsia-media
GCS_MEDIA_PUBLIC=true

# Claude
CLAUDE_PROVIDER=anthropic          # anthropic | vertex
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL_CHAT=claude-sonnet-5-5
CLAUDE_MODEL_FAST=claude-haiku-5-5
# CLAUDE_VERTEX_REGION=us-east5

# Embeddings para RAG (Firestore Vector Search)
EMBEDDINGS_PROVIDER=vertex         # vertex | voyage
EMBEDDINGS_MODEL=text-multilingual-embedding-002
EMBEDDING_DIM=768
# VOYAGE_API_KEY=...

# Cloud Tasks (vacío WORKER_URL = ejecución local en proceso)
WORKER_URL=
TASKS_QUEUE=xsia-default
TASKS_QUEUE_SEND=xsia-recovery-send
TASKS_INVOKER_SA=
TASKS_SHARED_SECRET=

# WhatsApp Cloud API (Meta)
META_APP_SECRET=
META_VERIFY_TOKEN=
GRAPH_API_VERSION=v23.0

# Google Maps Geocoding (directorio de distribuidores por cercanía)
GOOGLE_MAPS_API_KEY=
GOOGLE_TTS_ENABLED=true
GOOGLE_STT_ENABLED=true
DEFAULT_COUNTRY_CODE=52
