# Configuración web de Firebase (Consola Firebase → Configuración del proyecto → Tus apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tu-proyecto
VITE_FIREBASE_APP_ID=
# URL directa del servicio API en Cloud Run (recomendado para streaming del chat).
# Vacío = mismo origen (rewrites de Firebase Hosting o proxy de Vite en local).
VITE_API_BASE_URL=
